<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>DirectoryCleaner</AssemblyName>
		<RootNamespace>MediaDirectoryCleaner</RootNamespace>
		<DebugType>embedded</DebugType>
		<Authors>Irfan Charania</Authors>
		<Description>Clean Kodi/XBMC media directories by removing orphaned metadata files</Description>
		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.*</AssemblyVersion>
		<Deterministic>false</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Size.fs" />
		<Compile Include="Utility.fs" />
		<Compile Include="Domain.fs" />
		<Compile Include="Logging.fs" />
		<Compile Include="FileSystem.fs" />
		<Compile Include="Movies.fs" />
		<Compile Include="TVShows.fs" />
		<Compile Include="Music.fs" />
		<Compile Include="Program.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Argu" Version="6.2.5" />
		<PackageReference Include="FsToolkit.ErrorHandling" Version="5.1.0" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Update="FSharp.Core" Version="10.0.100" />
	</ItemGroup>
</Project>